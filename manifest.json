{
  "manifest_version": 3,
  "name": "页面关键词提取器",
  "version": "2.0.1", 
  "description": "根据用户定义的关键词，从网页中提取相关信息并导出为CSV文件。",
  "permissions": ["activeTab", "scripting", "downloads", "storage", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["utils.js", "content.js"],
    "run_at": "document_end"
  }],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png"
  }
}